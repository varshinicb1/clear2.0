product FintechAPI
    name "Fintech Payment API"
    version "1.0"
    description "Payment processing platform with accounts, transactions, invoices, and reconciliation"

data Account
    field id
        type uuid
        primary true
    field name
        type string
        required true
    field email
        type email
        required true
        unique true
    field balance
        type float
        default 0
    field currency
        type enum
        options ["USD", "EUR", "GBP", "INR", "JPY"]
    field status
        type enum
        options ["active", "frozen", "closed"]
    field kyc_verified
        type boolean
        default false
    field created_at
        type timestamp
        default now

data Transaction
    field id
        type uuid
        primary true
    field account_id
        type reference Account
        required true
    field type
        type enum
        options ["deposit", "withdrawal", "transfer", "payment", "refund"]
    field amount
        type float
        required true
        min 0.01
    field currency
        type enum
        options ["USD", "EUR", "GBP", "INR", "JPY"]
    field status
        type enum
        options ["pending", "processing", "completed", "failed", "cancelled"]
    field description
        type string
    field reference
        type string
        unique true
    field fee
        type float
        default 0
    field created_at
        type timestamp
        default now

data Invoice
    field id
        type uuid
        primary true
    field from_account
        type reference Account
        required true
    field to_account
        type reference Account
        required true
    field amount
        type float
        required true
        min 0.01
    field status
        type enum
        options ["draft", "sent", "paid", "overdue", "cancelled"]
    field due_date
        type timestamp
    field line_items
        type list of InvoiceItem
    field created_at
        type timestamp
        default now

data InvoiceItem
    field id
        type uuid
    field description
        type string
        required true
    field quantity
        type integer
        min 1
    field unit_price
        type float
        min 0
    field total
        type float

data Payout
    field id
        type uuid
        primary true
    field account
        type reference Account
        required true
    field amount
        type float
        required true
    field status
        type enum
        options ["pending", "processing", "completed", "failed"]
    field destination
        type string
        required true
    field created_at
        type timestamp
        default now

api REST /api/accounts
    get /
        return list of Account
        sort by created_at desc
    get /:id
        return Account by id
        error 404 if not found
    post /
        accept name, email, currency
        return created Account
        status 201
    put /:id
        accept name, email
        return updated Account
        error 404 if not found

api REST /api/transactions
    get /
        return list of Transaction
        paginate 50 per page
        filter by type, status, account_id
        sort by created_at desc
    get /:id
        return Transaction by id
        include account details
        error 404 if not found
    post /
        accept account_id, type, amount, currency, description, reference
        validate with rules
        return created Transaction
        status 201

api REST /api/invoices
    get /
        return list of Invoice
        paginate 20 per page
        filter by status, from_account
        sort by created_at desc
    get /:id
        return Invoice by id
        include from_account details, to_account details
        error 404 if not found
    post /
        accept from_account, to_account, amount, due_date, line_items
        return created Invoice
        status 201

api REST /api/payouts
    get /
        return list of Payout
        sort by created_at desc
    get /:id
        return Payout by id
        error 404 if not found
    post /
        accept account, amount, destination
        return created Payout
        status 201

rule TransactionValidation
    apply to Transaction
    require amount > 0
    require account exists in Account
    require reference is not empty

screen Dashboard
    title "Fintech Dashboard"
    section kpis
        show transactions as stat
            label "Total Volume"
    section recent
        show transactions as table
        sort by created_at desc
        limit 10
    section accounts
        show accounts as list

screen Accounts
    title "Accounts"
    section search
        search
            placeholder "Search accounts..."
    section grid
        show accounts as datagrid

screen Invoices
    title "Invoices"
    section overview
        show invoices as table
        sort by created_at desc
    section chart
        show invoices as bar
            label title
            value amount
    section calendar
        show invoices as calendar
            date due_date

screen TransactionHistory
    title "Transaction History"
    section timeline
        show transactions as timeline
            date created_at
    section search
        search
            placeholder "Search by reference..."

auth Default
    accept email, password, name
    session jwt
        expire 24 hours

config production
    port 8080
    rate_limit 50 per minute per ip

deploy cloudflare-workers
    routes /api/*
