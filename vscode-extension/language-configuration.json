{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["[", "]"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\w+\\s.*$",
    "decreaseIndentPattern": "^\\s*$"
  }
}
